<Window x:Class="WandEnhancer.Fork.Installer.InstallerWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GBTGAME · Wand 安装助手" Width="960" Height="720" MinWidth="880" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#101318" Foreground="#F2F5FA"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="Assets/appicon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A9B3C3" />
        <SolidColorBrush x:Key="Accent" Color="#68DDBB" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252B35" />
            <Setter Property="Foreground" Value="#F2F5FA" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#F2F5FA" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7DEEA" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Padding="3,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="19" Height="19" CornerRadius="4" BorderThickness="1" BorderBrush="#758298" Background="#101318" Margin="0,0,10,0">
                                    <Path x:Name="Check" Data="M 3,8 L 7,12 L 14,4" Stroke="#10281F" StrokeThickness="2" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" /><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Focus" Property="Opacity" Value="0.48" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Border Background="#303744" CornerRadius="3"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{StaticResource Accent}" HorizontalAlignment="Left" CornerRadius="3" /></Grid></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" Cursor="Hand">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Focus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="2,4">
                                <StackPanel Orientation="Horizontal"><Path x:Name="Chevron" Data="M 1,1 L 5,5 L 9,1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="10" Height="6" Margin="0,0,9,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" /><ContentPresenter /></StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#101318">
        <Grid.ColumnDefinitions><ColumnDefinition Width="254" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#171C24" Padding="26,30,24,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="GBTGAME" FontWeight="Bold" FontSize="17" /><TextBlock Text="Wand 安装助手" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Stages}" VerticalAlignment="Top" AutomationProperties.Name="安装步骤">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="StageNumber" Width="26" Height="26" Background="#252E3A" CornerRadius="13" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock x:Name="Number" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#A9B3C3" />
                            </Border>
                            <StackPanel Grid.Column="1"><TextBlock x:Name="StageTitle" Text="{Binding Title}" Foreground="#A9B3C3" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#939FB2" Margin="0,4,0,0" /></StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="进行中"><Setter TargetName="StageNumber" Property="Background" Value="{StaticResource Accent}" /><Setter TargetName="Number" Property="Foreground" Value="#10281F" /><Setter TargetName="StageTitle" Property="Foreground" Value="#F2F5FA" /></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="已完成"><Setter TargetName="StageNumber" Property="Background" Value="#214237" /><Setter TargetName="Number" Property="Foreground" Value="{StaticResource Accent}" /><Setter TargetName="StageTitle" Property="Foreground" Value="#E0EAE6" /></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="失败"><Setter TargetName="StageNumber" Property="Background" Value="#582C31" /><Setter TargetName="Number" Property="Foreground" Value="#FFB5B5" /><Setter TargetName="StageTitle" Property="Foreground" Value="#FFB5B5" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="AuthorText" Foreground="#D8DFEB" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Margin="0,8,0,0" FontSize="12"><Hyperlink x:Name="ForumLink" Foreground="{StaticResource Muted}" RequestNavigate="ForumNavigate"><Run x:Name="ForumText" /></Hyperlink></TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="38,32,38,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,13">
                    <TextBlock Text="{Binding Heading}" FontSize="29" FontWeight="SemiBold" />
                    <Border Background="#252C37" CornerRadius="5" Padding="9,4" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{Binding Version}" FontSize="11" Foreground="#C7D0DE" /></Border>
                </DockPanel>
                <TextBlock Text="从旧版清理到最后启动，交给安装助手。" FontSize="13" Foreground="{StaticResource Muted}" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,32,0,24">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="#1B212B" CornerRadius="12" Padding="27" MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#263D36" Margin="0,0,12,0">
                                <Path x:Name="StateIcon" Data="M 10,5 L 10,22 M 4,16 L 10,22 L 16,16 M 2,27 L 18,27" Stroke="{StaticResource Accent}" StrokeThickness="2" Stretch="Uniform" Width="16" Height="21" />
                            </Border>
                            <TextBlock x:Name="StatusTitle" Text="准备就绪" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="MessageText" Text="{Binding Message}" Foreground="#B5C0D1" FontSize="12" TextWrapping="Wrap" MaxHeight="90" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                        <DockPanel Grid.Row="2" Margin="0,22,0,10"><TextBlock Text="安装进度" FontSize="11" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding ProgressLabel}" HorizontalAlignment="Right" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" /></DockPanel>
                        <ProgressBar Grid.Row="3" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="6" AutomationProperties.Name="安装进度" />
                    </Grid>
                </Border>
                <Expander x:Name="LogExpander" Grid.Row="1" Header="查看本次执行记录" Foreground="{StaticResource Muted}" Margin="0,16,0,0" FontSize="11">
                    <TextBox x:Name="Details" Height="112" Margin="0,9,0,0" Padding="10" Background="#171C24" Foreground="#BDC7D7" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="安装日志" />
                </Expander>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox x:Name="Launch" Content="完成后启动 Wand" IsChecked="True" VerticalAlignment="Center" />
                <Button x:Name="InstallButton" Grid.Column="1" Content="{Binding ActionText}" MinWidth="136" Background="{StaticResource Accent}" Foreground="#10281F" Click="InstallClick" IsDefault="True" AutomationProperties.AutomationId="InstallButton" />
            </Grid>
            <StackPanel Grid.Row="3">
                <TextBlock Text="安装将关闭并卸载当前用户的旧版 Wand / WeMod。配置会先备份，清理后需要重新登录。" TextWrapping="Wrap" Foreground="#939FB2" FontSize="11" LineHeight="19" />
                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                    <Button x:Name="OpenLog" Content="打开日志文件" Click="OpenLogClick" Padding="10,6" FontSize="11" Margin="0,0,10,0" Visibility="Collapsed" />
                    <Button x:Name="OpenBackup" Content="打开配置备份" Click="OpenBackupClick" Padding="10,6" FontSize="11" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
