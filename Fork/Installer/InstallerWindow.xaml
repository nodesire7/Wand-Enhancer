<Window x:Class="WandEnhancer.Fork.Installer.InstallerWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WandEnhancer.Models"
        xmlns:local="clr-namespace:WandEnhancer.Fork.Installer"
        Title="GBTGAME · Wand 安装助手" Width="900" Height="760" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="Assets/appicon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/ColorScheme.xaml" />
                <ResourceDictionary Source="Style/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="KeyboardFocus" TargetType="Control">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Rectangle Margin="-3" Stroke="{DynamicResource Ring}" StrokeThickness="1" RadiusX="3" RadiusY="3" /></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="InstallerCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            </Style>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Foreground}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Foreground}" /></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="InstallerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="10,5" />
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ring}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="InstallerPrimaryButton" TargetType="Button" BasedOn="{StaticResource ColoredButton}">
                <Setter Property="Padding" Value="22,8" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Margin" Value="0" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Muted}" /><Setter Property="Foreground" Value="{DynamicResource MutedForeground}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ring}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OptionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="3" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                    <Border Background="{DynamicResource Border}" CornerRadius="2"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" Background="{DynamicResource Primary}" HorizontalAlignment="Left" CornerRadius="2" /></Grid></Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="BackupListStyle" TargetType="ListBox">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer x:Name="PART_ScrollViewer" Background="Transparent" Focusable="False" Padding="2" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"><ItemsPresenter /></ScrollViewer>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}" FocusVisualStyle="{StaticResource KeyboardFocus}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" Cursor="Hand">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="1,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path x:Name="Arrow" Data="M 1,1 L 5,5 L 9,1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="10" Height="6" Margin="0,0,9,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path><ContentPresenter /></StackPanel>
                            </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Muted}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Grid.Row="1" ContentSource="Content" />
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource Background}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Muted}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="22,25,18,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,30"><TextBlock Text="GBTGAME" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="Wand 安装助手" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,5,0,0" /></StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Stages}" VerticalAlignment="Top" AutomationProperties.Name="安装步骤">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="StageNumber" Width="22" Height="22" Background="{DynamicResource Secondary}" CornerRadius="3" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock x:Name="Number" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedForeground}" />
                            </Border>
                            <StackPanel Grid.Column="1"><TextBlock x:Name="StageTitle" Text="{Binding Title}" Foreground="{DynamicResource MutedForeground}" /><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource MutedForeground}" Margin="0,4,0,0" /></StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="进行中"><Setter TargetName="StageNumber" Property="Background" Value="{DynamicResource Primary}" /><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource PrimaryForeground}" /><Setter TargetName="StageTitle" Property="Foreground" Value="{DynamicResource Foreground}" /></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="已完成"><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Foreground}" /><Setter TargetName="StageTitle" Property="Foreground" Value="{DynamicResource Foreground}" /></DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="失败"><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Destructive}" /><Setter TargetName="StageTitle" Property="Foreground" Value="{DynamicResource Destructive}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2"><TextBlock x:Name="AuthorText" FontSize="11" /><TextBlock Margin="0,8,0,0" FontSize="11"><Hyperlink x:Name="ForumLink" RequestNavigate="ForumNavigate"><Run x:Name="ForumText" /></Hyperlink></TextBlock></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="25,23,25,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16" LastChildFill="False"><TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Bottom" Margin="12,0,0,4" /></DockPanel>
            <Border Grid.Row="1" x:Name="StatusPanel" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel><TextBlock x:Name="StatusTitle" Text="准备就绪" FontWeight="Medium" /><TextBlock Text="{Binding ProgressLabel}" FontSize="11" HorizontalAlignment="Right" TextAlignment="Right" Foreground="{DynamicResource MutedForeground}" /></DockPanel>
                    <TextBlock x:Name="MessageText" Text="{Binding Message}" Foreground="{DynamicResource MutedForeground}" FontSize="11" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" Margin="0,6,0,9" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="6" AutomationProperties.Name="安装进度" />
                </StackPanel>
            </Border>
            <local:AccordionGrid Grid.Row="2" x:Name="ContentSections" ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="36" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                <Expander x:Name="OptionsExpander" Header="安装选项" IsExpanded="True">
                <ScrollViewer x:Name="SettingsScroll" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Padding="14" x:Name="OptionsEditor" DataContext="{Binding Options}">
                        <StackPanel>
                            <TextBlock Text="我们要增强什么？" FontWeight="SemiBold" Margin="0,0,0,13" />
                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions><TextBlock Text="补丁方式" VerticalAlignment="Center" /><ComboBox x:Name="StrategyBox" Style="{StaticResource InstallerCombo}" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Strategy, Mode=TwoWay}" AutomationProperties.Name="补丁方式" ToolTip="Static 修改磁盘文件；Supervised 在每次启动时于内存中应用修改。"><ComboBoxItem Tag="{x:Static models:EPatchStrategy.Static}" Content="Static (推荐)" /><ComboBoxItem Tag="{x:Static models:EPatchStrategy.Supervised}" Content="Supervised" /></ComboBox></Grid>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                <TextBlock Text="激活 WeMod Pro" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" /><CheckBox x:Name="ActivateProBox" Grid.Column="1" Style="{StaticResource OptionCheck}" IsChecked="{Binding ActivatePro, Mode=TwoWay}" AutomationProperties.Name="激活 WeMod Pro" />
                                <TextBlock Grid.Row="1" Text="按 F12 打开开发者工具" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" /><CheckBox x:Name="DevToolsBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionCheck}" IsChecked="{Binding DevTools, Mode=TwoWay}" AutomationProperties.Name="按 F12 打开开发者工具" />
                                <TextBlock Grid.Row="2" Text="禁用更新" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" /><CheckBox x:Name="DisableUpdatesBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource OptionCheck}" IsChecked="{Binding DisableUpdates, Mode=TwoWay}" AutomationProperties.Name="禁用更新" ToolTip="启用后不检查 Wand 更新，同时关闭更新后自动应用。" />
                                <TextBlock Grid.Row="3" Text="启用远程访问（beta）" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" /><CheckBox x:Name="RemotePanelBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource OptionCheck}" IsChecked="{Binding RemotePanel, Mode=TwoWay}" AutomationProperties.Name="启用远程访问" />
                                <TextBlock Grid.Row="4" Text="更新后自动应用" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" /><CheckBox x:Name="AutoApplyBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource OptionCheck}" IsChecked="{Binding AutoApply, Mode=TwoWay}" AutomationProperties.Name="更新后自动应用" ToolTip="需要允许 Wand 更新，启用后会取消禁用更新。" />
                            </Grid>
                            <Border Margin="0,12,0,0" Padding="10" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource Muted}">
                                <StackPanel><DockPanel LastChildFill="False"><TextBlock Text="自定义脚本" VerticalAlignment="Center" /><Button x:Name="AddScriptButton" DockPanel.Dock="Right" Content="添加 .js" Click="AddScriptClick" Style="{StaticResource InstallerButton}" /></DockPanel>
                                    <TextBlock Text="选中的 .js 文件会打包到 Wand 并在渲染器中加载。" FontSize="11" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,7,0,4" />
                                    <ScrollViewer x:Name="ScriptScroll" Focusable="False" MaxHeight="82" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="ScriptList" ItemsSource="{Binding Scripts}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4,0,0" LastChildFill="True"><Button DockPanel.Dock="Right" Tag="{Binding}" Content="移除" AutomationProperties.Name="{Binding FileName, StringFormat=移除脚本 {0}}" Click="RemoveScriptClick" Style="{StaticResource InstallerButton}" Padding="7,2" FontSize="11" /><TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedForeground}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                    <TextBlock x:Name="NoScriptsText" Text="未选择脚本" FontSize="11" Foreground="{DynamicResource MutedForeground}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasScripts}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                </Expander>
                <Expander Grid.Row="1" x:Name="LogExpander" Header="本次执行记录" Foreground="{DynamicResource MutedForeground}" FontSize="12">
                    <TextBox x:Name="Details" Margin="0,7,0,5" Padding="10" Background="{DynamicResource Muted}" Foreground="{DynamicResource MutedForeground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="安装日志" />
                </Expander>
                <Expander Grid.Row="2" x:Name="BackupsExpander" Header="配置备份" Foreground="{DynamicResource Foreground}">
                    <Grid x:Name="BackupsPanel" Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel><Button x:Name="OpenBackupRoot" DockPanel.Dock="Right" Content="打开目录" Style="{StaticResource InstallerButton}" Click="OpenBackupRootClick" Margin="8,0,0,0" /><TextBox x:Name="BackupRootText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MutedForeground}" FontSize="10.5" VerticalAlignment="Center" Padding="0" AutomationProperties.Name="备份保存位置" /></DockPanel>
                            <TextBlock Text="恢复 Roaming 与注册表中的用户配置；恢复前自动保存当前配置。" Foreground="{DynamicResource MutedForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,9" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="BackupList" Style="{StaticResource BackupListStyle}" SelectionChanged="BackupSelectionChanged" Background="{DynamicResource Muted}" Foreground="{DynamicResource Foreground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="配置备份列表">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Secondary}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Border}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Ring}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,7"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyBackups" Text="还没有配置备份。安装时会自动创建。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" FontSize="11" IsHitTestVisible="False" />
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBox x:Name="SelectedBackupPath" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedForeground}" Padding="0" FontSize="10.5" AutomationProperties.Name="所选备份完整路径" />
                            <WrapPanel Margin="0,7,0,0"><Button x:Name="RestoreBackup" Content="恢复配置" Click="RestoreBackupClick" Style="{StaticResource InstallerButton}" Margin="0,0,7,0" /><Button x:Name="DeleteBackup" Content="删除备份" Click="DeleteBackupClick" Style="{StaticResource InstallerButton}" Margin="0,0,7,0" /><Button x:Name="OpenBackupFolder" Content="打开所选备份" Click="OpenBackupFolderClick" Style="{StaticResource InstallerButton}" Margin="0,0,7,0" /><Button x:Name="RefreshBackups" Content="刷新" Click="RefreshBackupsClick" Style="{StaticResource InstallerButton}" /></WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock x:Name="BackupFeedback" MaxHeight="48" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" FontSize="11" AutomationProperties.LiveSetting="Polite" />

                        </StackPanel>
                            <Border x:Name="BackupConfirmation" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Center" Background="{DynamicResource Muted}" Visibility="Collapsed" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="BackupConfirmationText" TextWrapping="Wrap" FontSize="11" /><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button x:Name="ConfirmBackup" Content="确认" Click="ConfirmBackupClick" Style="{StaticResource InstallerButton}" Margin="0,0,8,0" /><Button x:Name="CancelBackup" Content="取消" Click="CancelBackupClick" Style="{StaticResource InstallerButton}" /></StackPanel></StackPanel></Border>
                    </Grid>
                </Expander>
            </local:AccordionGrid>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="Launch" Style="{StaticResource OptionCheck}" IsChecked="True" Margin="0,0,8,0" AutomationProperties.Name="完成后启动 Wand" /><TextBlock Text="完成后启动 Wand" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" /></StackPanel><Button x:Name="InstallButton" Grid.Column="1" Content="{Binding ActionText}" MinWidth="118" Style="{StaticResource InstallerPrimaryButton}" Click="InstallClick" IsDefault="True" AutomationProperties.AutomationId="InstallButton" /></Grid>
                <TextBlock Text="安装将关闭并静默清理当前用户的旧版 Wand / WeMod。配置先备份，清理后需重新登录。" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" FontSize="10.5" LineHeight="17" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="OpenLog" Content="打开日志" Click="OpenLogClick" Style="{StaticResource InstallerButton}" FontSize="11" Margin="0,0,8,0" Visibility="Collapsed" /><Button x:Name="OpenBackup" Content="管理备份" Click="OpenBackupClick" Style="{StaticResource InstallerButton}" FontSize="11" Visibility="Collapsed" /></StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
